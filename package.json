{
  "name": "nebula-auth",
  "version": "1.0.0",
  "private": true,
  "description": "An interactive 3D login and sign-up experience built with Three.js, TypeScript and modern CSS.",
  "keywords": [
    "threejs",
    "webgl",
    "glsl",
    "typescript",
    "vite",
    "login",
    "glassmorphism",
    "accessibility"
  ],
  "author": {
    "name": "Arslan Agayev",
    "url": "https://github.com/arslanagayev"
  },
  "license": "MIT",
  "homepage": "https://arslanagayev.github.io/nebula-auth/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arslanagayev/nebula-auth.git"
  },
  "bugs": {
    "url": "https://github.com/arslanagayev/nebula-auth/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.2"
  }
}
